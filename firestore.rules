rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Hardened Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isBootstrappedTeacher() {
      return isVerified() && request.auth.token.email == 'heeju3185@gmail.com';
    }

    function isAdmin() {
      return isVerified() && (
        isBootstrappedTeacher() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // 3. Entity Validation Blueprints (Synchronized verbatim with firebase-blueprint.json)

    function isValidAdminRecord(data) {
      return data.keys().hasAll(['uid', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'role', 'createdAt']) &&
        data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.uid == request.auth.uid &&
        data.role is string && data.role.size() >= 5 && data.role.size() <= 20 && data.role in ['teacher', 'admin'] &&
        data.createdAt is timestamp;
    }

    function isValidAnnouncement(data) {
      return data.keys().hasAll(['title', 'category', 'content', 'isPinned', 'authorId', 'authorName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['title', 'category', 'content', 'isPinned', 'dueDate', 'authorId', 'authorName', 'createdAt', 'updatedAt']) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.category is string && data.category.size() >= 4 && data.category.size() <= 20 && data.category in ['notice', 'letter', 'assignment', 'event'] &&
        data.content is string && data.content.size() >= 2 && data.content.size() <= 2000 &&
        data.isPinned is bool &&
        (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() == 10 && data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCommunityPost(data) {
      return data.keys().hasAll(['topic', 'title', 'body', 'authorId', 'authorName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['topic', 'title', 'body', 'authorId', 'authorName', 'studentNumber', 'status', 'teacherReply', 'createdAt', 'updatedAt']) &&
        data.topic is string && data.topic.size() >= 4 && data.topic.size() <= 20 && data.topic in ['question', 'praise', 'suggestion', 'free'] &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.body is string && data.body.size() >= 2 && data.body.size() <= 1500 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
        (!('studentNumber' in data) || (data.studentNumber is string && data.studentNumber.size() >= 1 && data.studentNumber.size() <= 10 && data.studentNumber.matches('^[0-9]{1,5}$'))) &&
        data.status is string && data.status.size() >= 4 && data.status.size() <= 20 && data.status in ['open', 'answered', 'archived'] &&
        (!('teacherReply' in data) || (data.teacherReply is string && data.teacherReply.size() >= 1 && data.teacherReply.size() <= 1000)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPostComment(data) {
      return data.keys().hasAll(['postId', 'content', 'authorId', 'authorName', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['postId', 'content', 'authorId', 'authorName', 'createdAt', 'updatedAt']) &&
        data.postId is string && data.postId.size() >= 1 && data.postId.size() <= 128 && data.postId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.content is string && data.content.size() >= 1 && data.content.size() <= 500 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidLunchMenu(data) {
      return data.keys().hasAll(['date', 'dayLabel', 'rice', 'soup', 'mainDish', 'sideDish1', 'sideDish2', 'dessert', 'calories', 'allergyInfo', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['date', 'dayLabel', 'rice', 'soup', 'mainDish', 'sideDish1', 'sideDish2', 'dessert', 'calories', 'allergyInfo', 'authorId', 'createdAt', 'updatedAt']) &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.dayLabel is string && data.dayLabel.size() >= 1 && data.dayLabel.size() <= 20 &&
        data.rice is string && data.rice.size() >= 1 && data.rice.size() <= 60 &&
        data.soup is string && data.soup.size() >= 1 && data.soup.size() <= 60 &&
        data.mainDish is string && data.mainDish.size() >= 1 && data.mainDish.size() <= 80 &&
        data.sideDish1 is string && data.sideDish1.size() >= 1 && data.sideDish1.size() <= 80 &&
        data.sideDish2 is string && data.sideDish2.size() >= 1 && data.sideDish2.size() <= 80 &&
        data.dessert is string && data.dessert.size() >= 1 && data.dessert.size() <= 60 &&
        data.calories is number && data.calories >= 0 && data.calories <= 5000 &&
        data.allergyInfo is string && data.allergyInfo.size() >= 1 && data.allergyInfo.size() <= 120 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAcademicSchedule(data) {
      return data.keys().hasAll(['date', 'title', 'eventType', 'description', 'targetGrade', 'authorId', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['date', 'endDate', 'title', 'eventType', 'description', 'targetGrade', 'authorId', 'createdAt', 'updatedAt']) &&
        data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        (!('endDate' in data) || (data.endDate is string && data.endDate.size() == 10 && data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 100 &&
        data.eventType is string && data.eventType.size() >= 4 && data.eventType.size() <= 20 && data.eventType in ['exam', 'performance', 'activity', 'holiday', 'school'] &&
        data.description is string && data.description.size() >= 1 && data.description.size() <= 500 &&
        data.targetGrade is string && data.targetGrade.size() >= 3 && data.targetGrade.size() <= 20 && data.targetGrade in ['all', 'grade2', 'class2_3'] &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCounselingRequest(data) {
      return data.keys().hasAll(['topic', 'preferredDate', 'message', 'authorId', 'authorName', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['topic', 'preferredDate', 'message', 'authorId', 'authorName', 'status', 'teacherNote', 'createdAt', 'updatedAt']) &&
        data.topic is string && data.topic.size() >= 4 && data.topic.size() <= 20 && data.topic in ['study', 'friendship', 'career', 'health', 'other'] &&
        data.preferredDate is string && data.preferredDate.size() == 10 && data.preferredDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        data.message is string && data.message.size() >= 2 && data.message.size() <= 1000 &&
        data.authorId is string && data.authorId.size() >= 1 && data.authorId.size() <= 128 && data.authorId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.authorId == request.auth.uid &&
        data.authorName is string && data.authorName.size() >= 1 && data.authorName.size() <= 40 &&
        data.status is string && data.status.size() >= 4 && data.status.size() <= 20 && data.status in ['pending', 'scheduled', 'completed'] &&
        (!('teacherNote' in data) || (data.teacherNote is string && data.teacherNote.size() >= 1 && data.teacherNote.size() <= 500)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // 4. Collection Match Blocks

    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && (request.auth.uid == adminId || isAdmin());
      allow list: if false;
      allow create: if isSignedIn() && isVerified() && isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        adminId == request.auth.uid &&
        incoming().createdAt == request.time &&
        isBootstrappedTeacher();
      allow update: if isSignedIn() && isVerified() && isValidId(adminId) &&
        isValidAdminRecord(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['role']) &&
        isBootstrappedTeacher();
      allow delete: if isSignedIn() && isValidId(adminId) && isBootstrappedTeacher();
    }

    match /announcements/{announcementId} {
      allow get: if isSignedIn() && isValidId(announcementId) && existing().category in ['notice', 'letter', 'assignment', 'event'];
      allow list: if isSignedIn() && existing().category in ['notice', 'letter', 'assignment', 'event'];
      allow create: if isSignedIn() && isVerified() && isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() && isVerified() && isValidId(announcementId) &&
        isValidAnnouncement(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'content', 'isPinned', 'dueDate', 'updatedAt']))
        );
      allow delete: if isSignedIn() && isVerified() && isValidId(announcementId) && isAdmin();
    }

    match /posts/{postId} {
      allow get: if isSignedIn() && isValidId(postId) && existing().topic in ['question', 'praise', 'suggestion', 'free'];
      allow list: if isSignedIn() && existing().topic in ['question', 'praise', 'suggestion', 'free'];
      allow create: if isSignedIn() && isVerified() && isValidId(postId) &&
        isValidCommunityPost(incoming()) &&
        incoming().status == 'open' &&
        !('teacherReply' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isVerified() && isValidId(postId) &&
        isValidCommunityPost(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Student author edits their own unarchived post content
          (
            existing().authorId == request.auth.uid &&
            existing().status != 'archived' &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'title', 'body', 'updatedAt'])
          ) ||
          // Action 2: Homeroom teacher / Admin replies or updates post status
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'teacherReply', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isVerified() && isValidId(postId) && (
        (existing().authorId == request.auth.uid && existing().status != 'archived') ||
        isAdmin()
      );

      // Subcollection: Comments under a post (Master Gate Relational Sync)
      match /comments/{commentId} {
        allow get: if isSignedIn() && isValidId(postId) && isValidId(commentId) &&
          existing().postId == postId &&
          exists(/databases/$(database)/documents/posts/$(postId));
        allow list: if isSignedIn() && existing().postId == postId;
        allow create: if isSignedIn() && isVerified() && isValidId(postId) && isValidId(commentId) &&
          isValidPostComment(incoming()) &&
          incoming().postId == postId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          get(/databases/$(database)/documents/posts/$(postId)).data.status != 'archived';
        allow update: if isSignedIn() && isVerified() && isValidId(postId) && isValidId(commentId) &&
          isValidPostComment(incoming()) &&
          incoming().postId == existing().postId &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          get(/databases/$(database)/documents/posts/$(postId)).data.status != 'archived' &&
          (
            (existing().authorId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt'])) ||
            (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['content', 'updatedAt']))
          );
        allow delete: if isSignedIn() && isVerified() && isValidId(postId) && isValidId(commentId) &&
          exists(/databases/$(database)/documents/posts/$(postId)) &&
          (existing().authorId == request.auth.uid || isAdmin());
      }
    }

    match /lunchMenus/{menuId} {
      allow get: if isSignedIn() && isValidId(menuId) && existing().calories >= 0;
      allow list: if isSignedIn() && existing().calories >= 0;
      allow create: if isSignedIn() && isVerified() && isValidId(menuId) &&
        isValidLunchMenu(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() && isVerified() && isValidId(menuId) &&
        isValidLunchMenu(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['date', 'dayLabel', 'rice', 'soup', 'mainDish', 'sideDish1', 'sideDish2', 'dessert', 'calories', 'allergyInfo', 'updatedAt']);
      allow delete: if isSignedIn() && isVerified() && isValidId(menuId) && isAdmin();
    }

    match /schedules/{scheduleId} {
      allow get: if isSignedIn() && isValidId(scheduleId) && existing().targetGrade in ['all', 'grade2', 'class2_3'];
      allow list: if isSignedIn() && existing().targetGrade in ['all', 'grade2', 'class2_3'];
      allow create: if isSignedIn() && isVerified() && isValidId(scheduleId) &&
        isValidAcademicSchedule(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();
      allow update: if isSignedIn() && isVerified() && isValidId(scheduleId) &&
        isValidAcademicSchedule(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        isAdmin() &&
        incoming().diff(existing()).affectedKeys().hasOnly(['date', 'endDate', 'title', 'eventType', 'description', 'targetGrade', 'updatedAt']);
      allow delete: if isSignedIn() && isVerified() && isValidId(scheduleId) && isAdmin();
    }

    match /counselingRequests/{requestId} {
      // Strict PII & Confidentiality Isolation: Only the student owner or teacher can read
      allow get: if isSignedIn() && isValidId(requestId) && (existing().authorId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().authorId == request.auth.uid || isBootstrappedTeacher());
      allow create: if isSignedIn() && isVerified() && isValidId(requestId) &&
        isValidCounselingRequest(incoming()) &&
        incoming().status == 'pending' &&
        !('teacherNote' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() && isVerified() && isValidId(requestId) &&
        isValidCounselingRequest(incoming()) &&
        incoming().authorId == existing().authorId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          // Action 1: Student updates their own pending counseling request
          (
            existing().authorId == request.auth.uid &&
            existing().status == 'pending' &&
            incoming().status == 'pending' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['topic', 'preferredDate', 'message', 'updatedAt'])
          ) ||
          // Action 2: Teacher schedules or completes counseling and adds note
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'teacherNote', 'updatedAt'])
          )
        );
      allow delete: if isSignedIn() && isVerified() && isValidId(requestId) && (
        (existing().authorId == request.auth.uid && existing().status == 'pending') ||
        isAdmin()
      );
    }
  }
}
